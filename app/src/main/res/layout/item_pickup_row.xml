<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the Home "Recent pick-ups" list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PickupRow">

    <TextView android:id="@+id/tvAvatar" style="@style/PickupAvatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">
        <TextView android:id="@+id/tvName" style="@style/PickupName" />
        <TextView android:id="@+id/tvDetail" style="@style/PickupDetail" />
    </LinearLayout>

    <TextView android:id="@+id/tvBadge" style="@style/StatusBadge.Verified" />
</LinearLayout>

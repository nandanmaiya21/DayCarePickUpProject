<?xml version="1.0" encoding="utf-8"?>
<!--
    Log tab: pick-up history (View layer).
    Times, names and scores are sample data; the controller
    will replace them at runtime.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/logScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    tools:context=".Fragments.LogFragment"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_title"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- Search -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_search_field"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="14dp"
            app:drawableTint="@color/text_secondary"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:hint="@string/log_search_hint"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <!-- Date filter chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipToday"
                style="@style/LogChip.Selected"
                android:text="@string/log_today" />

            <TextView
                android:id="@+id/chipYesterday"
                style="@style/LogChip.Unselected"
                android:layout_marginStart="10dp"
                android:text="@string/log_yesterday" />

            <TextView
                android:id="@+id/chipPickDate"
                style="@style/LogChip.Unselected"
                android:layout_marginStart="10dp"
                android:drawableStart="@drawable/ic_calendar_small"
                android:drawablePadding="8dp"
                app:drawableTint="@color/text_primary"
                android:paddingStart="18dp"
                android:text="@string/log_pick_date" />
        </LinearLayout>

        <!-- Status tabs (text with counts is set in LogFragment) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/statusTabs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabMinWidth="0dp"
            app:tabPaddingStart="0dp"
            app:tabPaddingEnd="22dp"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorColor="@color/brand_blue"
            app:tabSelectedTextColor="@color/brand_blue"
            app:tabTextColor="@color/text_secondary"
            app:tabTextAppearance="@style/LogTabText"
            app:tabRippleColor="@null" />

        <View style="@style/ListDivider" android:background="@color/card_stroke" />

        <!-- Date header -->
        <TextView
            android:id="@+id/tvDateHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SUN, NOV 8"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <!-- Log entries -->
        <LinearLayout
            android:id="@+id/logList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white">

            <LinearLayout style="@style/PickupRow">
                <TextView style="@style/LogTime" android:text="3:42 PM" />
                <LinearLayout style="@style/LogInfo">
                    <TextView style="@style/PickupName" android:text="Ava Okafor" />
                    <TextView style="@style/PickupDetail" android:text="Daniel Okafor · 97.8%" />
                </LinearLayout>
                <TextView style="@style/StatusBadge.Verified" />
            </LinearLayout>

            <View style="@style/ListDivider" />

            <LinearLayout style="@style/PickupRow">
                <TextView style="@style/LogTime" android:text="3:31 PM" />
                <LinearLayout style="@style/LogInfo">
                    <TextView style="@style/PickupName" android:text="Leo Martin" />
                    <TextView style="@style/PickupDetail" android:text="Sophie Martin · 96.1%" />
                </LinearLayout>
                <TextView style="@style/StatusBadge.Verified" />
            </LinearLayout>

            <View style="@style/ListDivider" />

            <LinearLayout style="@style/PickupRow">
                <TextView style="@style/LogTime" android:text="3:18 PM" />
                <LinearLayout style="@style/LogInfo">
                    <TextView style="@style/PickupName" android:text="Zara Khan" />
                    <TextView style="@style/PickupDetail" android:text="Imran Khan · by Priya S." />
                </LinearLayout>
                <TextView style="@style/StatusBadge.Override" />
            </LinearLayout>

            <View style="@style/ListDivider" />

            <LinearLayout style="@style/PickupRow">
                <TextView style="@style/LogTime" android:text="3:16 PM" />
                <LinearLayout style="@style/LogInfo">
                    <TextView style="@style/PickupName" android:text="Zara Khan" />
                    <TextView style="@style/PickupDetail" android:text="Unknown face · 41%" />
                </LinearLayout>
                <TextView style="@style/StatusBadge.Rejected" />
            </LinearLayout>

            <View style="@style/ListDivider" />

            <LinearLayout style="@style/PickupRow">
                <TextView style="@style/LogTime" android:text="3:05 PM" />
                <LinearLayout style="@style/LogInfo">
                    <TextView style="@style/PickupName" android:text="Mia Chen" />
                    <TextView style="@style/PickupDetail" android:text="Wei Chen · 98.4%" />
                </LinearLayout>
                <TextView style="@style/StatusBadge.Verified" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

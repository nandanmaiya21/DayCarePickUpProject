<?xml version="1.0" encoding="utf-8"?>
<!-- Add child screen (View layer). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    tools:context=".AddChildScreen"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_primary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Add child"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enter the child's details."
            android:textSize="16sp"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutChildName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:textColorHint="@color/text_secondary"
            app:hintTextColor="@color/brand_blue"
            app:boxStrokeColor="@color/brand_blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Child's full name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChildName"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:textColorHint="@color/text_secondary"
            app:hintTextColor="@color/brand_blue"
            app:boxStrokeColor="@color/brand_blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Room (e.g. Sunflowers)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChildRoom"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:textColorHint="@color/text_secondary"
            app:hintTextColor="@color/brand_blue"
            app:boxStrokeColor="@color/brand_blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Date of birth (DD/MM/YYYY)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChildDob"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveChild"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Save child"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_blue"
            app:cornerRadius="20dp" />
    </LinearLayout>
</ScrollView>
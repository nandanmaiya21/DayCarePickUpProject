<?xml version="1.0" encoding="utf-8"?>
<!-- One child in the Children list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PickupRow"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvAvatar"
        style="@style/PickupAvatar"
        android:background="@drawable/bg_avatar_orange"
        android:textColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">
        <TextView android:id="@+id/tvName" style="@style/PickupName" />
        <TextView android:id="@+id/tvDetail" style="@style/PickupDetail" />
    </LinearLayout>

    <TextView android:id="@+id/tvBadge" style="@style/StatusBadge.Neutral" />
</LinearLayout>
